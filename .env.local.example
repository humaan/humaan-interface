DATABASE_URI=mongodb://127.0.0.1:27017/humaan-interface
PAYLOAD_SECRET=replace-with-a-long-random-value
NEXT_PUBLIC_SITE_URL=http://localhost:3000

IMAGEKIT_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_ROOT_FOLDER=/humaan-interface-development

# Optional shared Basic Auth. Leave both unset for public mode.
HT_USER=
HT_PASSWORD=

# Optional Payload admin login prefill in development.
PAYLOAD_DEV_EMAIL=
PAYLOAD_DEV_PASSWORD=

# Optional comma-separated lists for non-default hosts.
CORS_ALLOWED=
CSRF_ALLOWED=
